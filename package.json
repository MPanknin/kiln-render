{
  "name": "kiln-render",
  "version": "0.4.1",
  "description": "A WebGPU-native out-of-core renderer for large virtualized volumetric data",
  "author": {
    "name": "mpanknin",
    "email": "martinpanknin@gmail.com",
    "url": "https://github.com/MPanknin"
  },
  "license": "Apache-2.0",
  "homepage": "https://kilnrender.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpanknin/kiln-render.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/kiln-render.js"
    }
  },
  "module": "./lib/kiln-render.js",
  "types": "./lib/index.d.ts",
  "keywords": [
    "webgpu",
    "volume-rendering",
    "raymarching",
    "ome-zarr",
    "zarr",
    "3d",
    "medical-imaging",
    "scientific-visualization",
    "out-of-core",
    "streaming"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "dev:multichannel": "vite --config vite.multichannel.config.ts",
    "dev:site": "vitepress dev docs",
    "build": "tsc && vite build",
    "build:multichannel": "vite build --config vite.multichannel.config.ts",
    "build:site": "vitepress build docs",
    "preview:site": "vitepress preview docs",
    "build:all": "npm run build:site && npm run build && npm run build:multichannel",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && rm -rf lib/assets && node scripts/postbuild-lib.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:publish": "npm run build:lib && npx --yes publint && npx --yes @arethetypeswrong/cli --pack ."
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "fflate": "^0.8.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.39",
    "wgpu-matrix": "^3.4.0",
    "zarrita": "^0.6.1"
  }
}
